# Configure these in Railway Variables; never commit real secrets.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Use true only when your PostgreSQL endpoint supports trusted TLS.
DATABASE_SSL=false
# Isolate outreach tables when connecting an existing database.
DATABASE_SCHEMA=outreach
# A random key of at least 32 characters, used once at /admin to create the owner.
ADMIN_SETUP_TOKEN=replace-with-a-long-random-deployment-setup-key
# Notification recipients are stored in PostgreSQL and managed in the dashboard.
# Initial recipient: contact@fabricioguardia.com
EMAIL_FROM_NAME=The Salon Agent
# Must be an address on a domain verified by your email provider.
EMAIL_FROM_EMAIL=contact@fabricioguardia.com
# Resend SMTP takes priority over generic SMTP. Set one transport.
RESEND_API_KEY=
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
PUBLIC_SITE_URL=https://outreach-production-324f.up.railway.app
# Railway provides PORT.
PORT=3000
